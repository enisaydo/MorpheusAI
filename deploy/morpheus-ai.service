# Container kullanılmayan Linux sunucular için systemd servisi (root ile çalışır)
# Kurulum (root olarak):
#   git clone https://github.com/enisaydo/MorpheusAI.git /opt/morpheus-ai
#   cp /opt/morpheus-ai/deploy/morpheus-ai.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now morpheus-ai
[Unit]
Description=MorpheusAI - Ansible uyum analiz arayüzü
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/morpheus-ai
ExecStart=/usr/bin/node /opt/morpheus-ai/server.js
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
