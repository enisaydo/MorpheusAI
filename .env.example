PORT=3000
HOST_PORT=3000

# Kurum gateway sertifikası doğrulanmaz (self-signed certificate hatası için)
GENAI_TLS_INSECURE=true
# AI cevap süresi sınırı (ms) — akıl yürüten modeller uzun sürebilir
GENAI_TIMEOUT_MS=180000

# ===================== 1) TMS TOKEN =====================
TMS_TOKEN_URL=

# Body
TMS_BODY={"client_id":"","client_secret":"","grant_type":"password","username":"","password":""}

# Headers
TMS_H_GUID=
TMS_H_DIALECT=TR
TMS_H_IP=127.0.0.1
TMS_H_CHANNEL=B2B
TMS_H_X_FORWARDED_FOR=127.0.0.1
TMS_H_USERID=
TMS_H_ACCEPT=application/json
TMS_H_CONTENT_TYPE=application/json

# ===================== 2) CHAT COMPLETIONS =====================
CHAT_URL=

# Body
CHAT_MODEL_FIELD=model_name
CHAT_MODEL=gpt-5.5
# gpt-5.x düşünme + cevap için toplam bütçe; düşükse cevap boş gelir
CHAT_BODY_EXTRA={"max_completion_tokens":16000}

# Headers (Authorization: Bearer <token> otomatik eklenir)
CHAT_H_GUID=
CHAT_H_CHANNEL=Branch
CHAT_H_DIALECT=TR
CHAT_H_ACCEPT=application/json
CHAT_H_CONTENT_TYPE=application/json
CHAT_H_IP=127.0.0.1
CHAT_H_CLIENT_ID=
CHAT_H_ACCEPT_ENCODING=gzip, deflate, br
CHAT_H_ACCEPT_LANGUAGE=en-US,en;q=0.9
CHAT_H_CLIENT_SESSION_ID=
CHAT_H_PROJECT_INFO=morpheusai
CHAT_H_USER_ID=

# ===================== 3) ANSIBLE AUTOMATION PLATFORM =====================
# Boş bırakılırsa örnek (mock) template/workflow verisi gösterilir
AAP_URL=
# Boş = otomatik algıla (AAP 2.5/2.6: /api/controller/v2, 2.4/AWX: /api/v2)
AAP_API_PREFIX=
# Tercihen token (AAP → Kullanıcı → Tokens, scope: Read); yoksa kullanıcı/parola
AAP_TOKEN=
AAP_USERNAME=
AAP_PASSWORD=
# Sadece bu organizasyonun template'leri (opsiyonel)
AAP_ORGANIZATION=
AAP_TLS_INSECURE=true

# Container içinde çözülemeyen kurum içi adlar için ad:ip eşlemeleri (virgülle ayrılmış, opsiyonel)
# Örnek: PODMAN_ADD_HOSTS=maestro3:10.1.2.3,maestro3.kurum.local:10.1.2.3
PODMAN_ADD_HOSTS=

# ===================== TOKEN KULLANIMI =====================
# Günlük limitler arayüzden (Ayarlar → Token limitleri) belirlenir; data/limits.json'da saklanır.
# Gün sınırı bu saat dilimine göre hesaplanır
USAGE_TIMEZONE=Europe/Istanbul
# Önünde kurumsal giriş (SSO) yapan bir proxy varsa, kullanıcı adını taşıyan header (ör. x-remote-user).
# Boşsa arayüzde girilen kullanıcı adı kullanılır (doğrulanmaz).
USER_HEADER=

# ===================== LOG =====================
# AI/AAP istek-cevapları logs/ai-YYYY-MM-DD.jsonl dosyasına yazılır (gizli alanlar maskelenir)
AI_LOG_FILE=true
