# =====================================================================
#  MorpheusAI - ortam değişkenleri
#  cp .env.example .env  →  <...> alanlarını doldurun.
#  .env .gitignore'dadır, ASLA commit'lemeyin.
#  Değerleri tırnaksız yazın; satır sonuna yorum eklemeyin (Podman --env-file).
#  <...> içeren URL'ler varken uygulama DEMO modunda (mock veri) çalışır.
# =====================================================================

PORT=3000
# dışarı açılan port (podman / compose)
HOST_PORT=3000
# boş = otomatik (genai | proxy | demo)
MORPHEUS_MODE=
# ayrı bir AI backend'e proxy için (GenAI kullanılıyorsa boş)
AI_BACKEND_URL=

# Yer tutucular:  {{env:İSİM}} başka değişken,  {{uuid}} her istekte yeni UUID,  {{token}} TMS token

# ---- Ortak --------------------------------------------------------------
GENAI_CLIENT_ID=<client-id>
GENAI_GUID=<guid>
GENAI_USER_ID=<kullanici-id>

# ---- 1) TMS token -------------------------------------------------------
TMS_TOKEN_URL=https://<api-gateway>/authentication/tms/v3/tmsToken
TMS_CLIENT_SECRET=<client-secret>
TMS_USERNAME=<kullanici-adi>
TMS_PASSWORD=<parola>

TMS_BODY={"client_id":"{{env:GENAI_CLIENT_ID}}","client_secret":"{{env:TMS_CLIENT_SECRET}}","grant_type":"password","username":"{{env:TMS_USERNAME}}","password":"{{env:TMS_PASSWORD}}"}

# Header'lar: TMS_H_<HEADER_ADI>  ( _ → - , büyük/küçük harf önemsiz )
TMS_H_GUID={{env:GENAI_GUID}}
TMS_H_DIALECT=TR
TMS_H_IP=127.0.0.1
TMS_H_CHANNEL=B2B
TMS_H_X_FORWARDED_FOR=127.0.0.1
TMS_H_USERID={{env:GENAI_USER_ID}}
TMS_H_ACCEPT=application/json
TMS_H_CONTENT_TYPE=application/json

# Token yeri: önce JSON gövde (TMS_TOKEN_PATH, boş = otomatik), sonra bu response header'ı
TMS_TOKEN_HEADER=authorization
TMS_TOKEN_PATH=
# Süre: gövde/expires_in header'ı bulunamazsa
TMS_TOKEN_TTL_SECONDS=300

# ---- 2) Chat completions ------------------------------------------------
CHAT_URL=https://<api-gateway>/sdlc-genai-management/sdlc-genai-ch/v0/chat/completions

CHAT_H_GUID={{env:GENAI_GUID}}
CHAT_H_CHANNEL=Branch
CHAT_H_DIALECT=TR
CHAT_H_ACCEPT=application/json
CHAT_H_CONTENT_TYPE=application/json
CHAT_H_IP=127.0.0.1
CHAT_H_CLIENT_ID={{env:GENAI_CLIENT_ID}}
CHAT_H_ACCEPT_ENCODING=gzip, deflate, br
CHAT_H_ACCEPT_LANGUAGE=en-US,en;q=0.9
CHAT_H_CLIENT_SESSION_ID=<client-session-id>
CHAT_H_PROJECT_INFO=morpheusai
CHAT_H_USER_ID={{env:GENAI_USER_ID}}
# Authorization: Bearer <token> otomatik eklenir

CHAT_MODEL=gpt-5.5
CHAT_MODEL_FIELD=model_name
CHAT_BODY_EXTRA={"max_completion_tokens":1440}
CHAT_REPLY_PATH=choices.0.message.content

# ---- Bağlantı -----------------------------------------------------------
GENAI_TIMEOUT_MS=60000
# Kurum içi CA için tercihen: NODE_EXTRA_CA_CERTS=/yol/kurum-ca.pem
GENAI_TLS_INSECURE=false
# true: giden istekleri maskelenmiş olarak logla
GENAI_DEBUG=false
