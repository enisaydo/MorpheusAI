# =====================================================================
#  MorpheusAI - ortam değişkenleri
#  Bu dosyayı .env olarak kopyalayıp doldurun:   cp .env.example .env
#  .env dosyası .gitignore'dadır, ASLA commit'lemeyin.
# =====================================================================

# ---- Genel ----------------------------------------------------------
PORT=3000
HOST_PORT=3000                 # docker-compose için dış port
# MORPHEUS_MODE=               # boş = otomatik (genai | proxy | demo)

# Ayrı bir AI backend servisiniz varsa (proxy modu). GenAI kullanacaksanız boş bırakın.
AI_BACKEND_URL=

# =====================================================================
#  1) TOKEN — TMS token servisi
# =====================================================================
TMS_TOKEN_URL=https://<api-gateway>/authentication/tms/v3/tmsToken
TMS_METHOD=POST

# İstek gövdesi (Bruno'daki Body sekmesinin aynısı, tek satır JSON)
TMS_BODY={"clientId":"<client-id>","clientSecret":"<client-secret>"}

# Auth sekmesinde Basic Auth varsa:
TMS_BASIC_USER=
TMS_BASIC_PASS=

# TMS header'ları:  TMS_H_<HEADER_ADI>  ( _ → -  ,  büyük/küçük harf önemsiz )
TMS_H_GUID=<guid>
TMS_H_DIALECT=TR
TMS_H_IP=127.0.0.1
TMS_H_CHANNEL=B2B
TMS_H_X_FORWARDED_FOR=127.0.0.1
TMS_H_USERID=<kullanici-id>
TMS_H_ACCEPT=application/json
TMS_H_CONTENT_TYPE=application/json
TMS_H_COOKIE=

# Token yanıt JSON'unda nerede? (boş = access_token / token / data.token ... otomatik dener)
TMS_TOKEN_PATH=
# Süre alanı (boş = expires_in otomatik); bulunamazsa TTL kullanılır
TMS_EXPIRES_PATH=
TMS_TOKEN_TTL_SECONDS=300

# =====================================================================
#  2) CHAT — chat/completions
# =====================================================================
CHAT_URL=https://<api-gateway>/sdlc-genai-management/sdlc-genai-ch/v0/chat/completions

# Chat header'ları:  CHAT_H_<HEADER_ADI>
# Authorization otomatik eklenir:  Authorization: Bearer <TMS token>
# Değerlerde {{uuid}} → her istekte yeni UUID,  {{token}} → TMS token
CHAT_H_GUID=<guid>
CHAT_H_CHANNEL=Branch
CHAT_H_DIALECT=TR
CHAT_H_ACCEPT=application/json
CHAT_H_CONTENT_TYPE=application/json
CHAT_H_IP=127.0.0.1
CHAT_H_CLIENT_ID=<client-id>
CHAT_H_ACCEPT_ENCODING=gzip, deflate, br
CHAT_H_ACCEPT_LANGUAGE=en-US,en;q=0.9
CHAT_H_CLIENT_SESSION_ID={{uuid}}
CHAT_H_PROJECT_INFO=morpheusai
CHAT_H_USER_ID=<kullanici-id>

CHAT_AUTH_HEADER=Authorization
CHAT_AUTH_PREFIX=Bearer

# Gövde: {"model": CHAT_MODEL, "messages": [...], ...CHAT_BODY_EXTRA}
CHAT_MODEL=
CHAT_BODY_EXTRA={"temperature":0.2}

# Cevap metninin yanıt JSON'undaki yolu (OpenAI uyumlu varsayılan)
CHAT_REPLY_PATH=choices.0.message.content

# =====================================================================
#  Bağlantı
# =====================================================================
GENAI_TIMEOUT_MS=60000
# Kurum içi sertifika: tercihen NODE_EXTRA_CA_CERTS=/path/kurum-ca.pem kullanın.
# Sadece test ortamında, son çare olarak:
GENAI_TLS_INSECURE=false
# İstek/yanıt loglaması (gizli header'lar maskelenir)
GENAI_DEBUG=false
